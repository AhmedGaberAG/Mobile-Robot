<?xml version="1.0"?>

<robot name="ddr_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find ddr_description)/urdf/properties.xacro" />
    <xacro:include filename="$(find ddr_description)/urdf/gazebo.xacro" />
    <xacro:include filename="$(find ddr_description)/urdf/ros2_control.xacro" />
    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:inertial_box mass="${base_mass}" x="${base_length}" y="${base_width}"
                                z="${base_height}">
                            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_length}" 
                                                        radius="${wheel_radius}">
                                    <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </xacro:inertial_cylinder>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" 
                               radius="${caster_radius}">
                               <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="dark_grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}" length="${lidar_length}" 
                                                      radius="${lidar_radius}">
                                <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>
    
    <link name="camera_optical_frame" />

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0" />
            <material name="green" />
        </visual>
        <collision>
             <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0" />
        </collision>
        <xacro:inertial_box mass="${camera_mass}" x="${camera_length}" y="${camera_width}"
                                z="${camera_height}">
                            <origin xyz="0 0 0" rpy="0 ${pi / 2.0} 0" />
        </xacro:inertial_box>
    </link>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:inertial_box mass="${imu_mass}" x="${imu_length}" y="${imu_width}"
                                z="${imu_height}">
                            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <xacro:macro name="wheel_joint" params="prefix sign">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${prefix}_wheel_link" />
            <origin xyz="-${base_length / 4.0} ${sign * wheel_separation / 2.0} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <xacro:wheel_joint prefix="right" sign="-1" />
    <xacro:wheel_joint prefix="left" sign="1" />

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length / 3.0} 0 -${caster_radius}" rpy="0 0 0" />
    </joint>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_link" />
        <origin xyz="0 0 ${base_height + lidar_length / 2.0}" rpy="0 0 0" />
    </joint>
    
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}" />
    </joint>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="${base_length / 2.0 + camera_height / 2.0} 0 ${base_height / 2.0}" rpy="0 0 0" />
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
    </joint>

</robot>
